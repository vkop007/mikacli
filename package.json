{
  "name": "@vk007/mikacli",
  "version": "1.2.0",
  "description": "Terminal automation toolkit for developers and AI agents across LLMs, social platforms, developer tools, editors, data tools, and public utilities.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vkop007/mikacli.git"
  },
  "homepage": "https://github.com/vkop007/mikacli#readme",
  "bugs": {
    "url": "https://github.com/vkop007/mikacli/issues"
  },
  "packageManager": "bun@1.3.6",
  "keywords": [
    "agent-tools",
    "bun",
    "cli",
    "automation",
    "instagram",
    "mcp",
    "twitter",
    "x"
  ],
  "preferGlobal": true,
  "bin": {
    "mikacli": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "mikacli": {
    "schemaVersion": 1,
    "developerCli": {
      "channel": "npm",
      "package": "@vk007/mikacli",
      "executable": "mikacli",
      "entrypoint": "dist/index.js",
      "runtime": "node"
    },
    "managedDistribution": {
      "channel": "npm-platform-packages",
      "format": "standalone-executable",
      "requiresNode": false,
      "checksumAlgorithm": "sha256",
      "integrityAlgorithm": "sha256",
      "stateDirectoryEnvironmentVariable": "MIKACLI_HOME",
      "manifestUrl": "https://github.com/vkop007/mikacli/releases/download/v1.2.0/mikacli-native-manifest.json",
      "targets": [
        "darwin-arm64",
        "darwin-x64",
        "linux-arm64",
        "linux-x64",
        "windows-x64"
      ]
    },
    "catalog": {
      "schemaVersion": 1,
      "revisionSource": "package-version",
      "discovery": "dynamic-registry",
      "stateSchemaVersion": 1
    },
    "mcp": {
      "transport": "streamable-http",
      "endpoint": "/mcp",
      "healthEndpoint": "/health",
      "protocolVersion": "2025-06-18",
      "managementProtocolVersion": "1.0",
      "tools": [
        "mika_list_platforms",
        "mika_describe",
        "mika_auth_status",
        "mika_run",
        "mika_manage_platform"
      ]
    }
  },
  "scripts": {
    "generate:platform-registry": "bun run scripts/generate-platform-registry.ts",
    "pregenerate:readme": "bun run generate:platform-registry",
    "pregenerate:skill-providers": "bun run generate:platform-registry",
    "predev": "bun run generate:platform-registry",
    "dev": "bun run src/index.ts",
    "predev:watch": "bun run generate:platform-registry",
    "dev:watch": "bun run --watch src/index.ts",
    "prestart": "bun run generate:platform-registry",
    "start": "bun run src/index.ts",
    "prebuild": "bun run generate:platform-registry",
    "prepare": "bun run build",
    "prepublishOnly": "bun run sync:docs && bun run typecheck && bun test && bun run build",
    "link:global": "bun run scripts/link-global.ts",
    "generate:readme": "bun run scripts/generate-readme.ts",
    "generate:skill-providers": "bun run scripts/generate-skill-provider-references.ts",
    "sync:docs": "bun run generate:readme && bun run sync:skills",
    "sync:skills": "bun run scripts/sync-skills.ts",
    "pretypecheck": "bun run generate:platform-registry",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run generate:platform-registry",
    "build": "bun build --target=node --format=esm --external tlsclientwrapper --external playwright-core --outdir dist ./src/index.ts",
    "build:bin": "bun build --compile --target=bun --define __MIKACLI_STANDALONE__=true --external electron --external 'chromium-bidi/*' --outfile bin/mikacli ./src/index.ts",
    "build:native": "bun run scripts/build-native-distribution.ts",
    "build:native:current": "bun run scripts/build-native-distribution.ts --target current",
    "verify:native": "bun run scripts/verify-native-distribution.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "commander": "^14.0.3",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fast-xml-parser": "^5.5.9",
    "fetch-cookie": "^3.2.0",
    "jimp": "^0.16.7",
    "jsqr": "^1.4.0",
    "libsignal": "^2.0.1",
    "marked": "^17.0.5",
    "open-location-code": "^1.0.3",
    "ora": "^9.3.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "playwright-core": "^1.58.2",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22",
    "tlsclientwrapper": "^4.2.0",
    "tough-cookie": "^6.0.1",
    "turndown": "^7.2.2",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "koffi"
  ]
}
